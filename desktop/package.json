{
  "name": "sovereign-cowork",
  "productName": "SOVEREIGN Cowork",
  "version": "0.7.3",
  "description": "SOVEREIGN Cowork — ish stolidagi AI koding hamkori.",
  "type": "module",
  "main": "main.mjs",
  "author": "SOVEREIGN (Islombek)",
  "homepage": "https://soveregn.xyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isa704480/Sovereign.git"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "start:offline": "vite build && cross-env SOV_OFFLINE=1 electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "icons": "node scripts/make-icons.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "release:win": "vite build && electron-builder --win --publish always",
    "release:mac": "vite build && electron-builder --mac --publish always",
    "release:linux": "vite build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "electron-updater": "^6.8.9",
    "pdf-parse": "^2.4.5"
  },
  "build": {
    "appId": "app.sovereign.cowork",
    "productName": "SOVEREIGN Cowork",
    "copyright": "© 2026 SOVEREIGN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "electron/**",
      "ui-dist/**",
      "package.json",
      "!**/node_modules/{pdfjs-dist,pdf-parse}/**/*.map",
      "!**/node_modules/{pdfjs-dist,pdf-parse}/**/*.d.{ts,cts,mts}",
      "!**/node_modules/pdfjs-dist/{build,web,types,image_decoders}/**",
      "!**/node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!**/node_modules/pdf-parse/dist/{worker,node}/**",
      "!**/node_modules/pdf-parse/dist/pdf-parse/{web,cjs}/**",
      "!**/node_modules/pdf-parse/bin/**",
      "!**/node_modules/@lydell/**/*.pdb"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty/**",
      "**/node_modules/@lydell/node-pty-*/**"
    ],
    "extraResources": [
      {
        "from": "../cli/src",
        "to": "cli/src",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "../cli/package.json",
        "to": "cli/package.json"
      }
    ],
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "isa704480",
        "repo": "Sovereign",
        "releaseType": "release",
        "tagNamePrefix": "desktop-v"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SOVEREIGN Cowork",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "SOVEREIGN Cowork",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "SOVEREIGN-Cowork-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "SOVEREIGN-Cowork-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "SOVEREIGN Cowork ${version}",
      "artifactName": "SOVEREIGN-Cowork-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "AI coding coworker for your desktop",
      "artifactName": "SOVEREIGN-Cowork-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "SOVEREIGN-Cowork-${version}-${arch}.${ext}"
    }
  }
}

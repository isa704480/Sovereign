{
  "name": "sovereign-cowork",
  "productName": "SOVEREIGN Cowork",
  "version": "0.2.0",
  "description": "SOVEREIGN Cowork — ish stolidagi AI koding hamkori (React + Electron).",
  "type": "module",
  "main": "main.mjs",
  "author": "Islombek",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "app.sovereign.cowork",
    "productName": "SOVEREIGN Cowork",
    "files": ["main.mjs", "preload.cjs", "ui-dist/**", "../cli/src/**"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}

# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Direct Postgres connection for `npm run db:migrate`
# (Project Settings → Database → Connection string → URI; parolni [YOUR-PASSWORD] o'rniga qo'ying)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Public origin used to build OAuth redirect URLs.
# Dev: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI providers ---
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
# OpenAI kaliti (audio transkripsiya — Whisper uchun; ixtiyoriy)
OPENAI_API_KEY=

# Tekin/tez to'g'ridan-to'g'ri provayderlar (ixtiyoriy — bo'lsa OpenRouter chetlab o'tiladi)
GROQ_API_KEY=
# Cloudflare Workers AI (kuniga 10 000 neuron tekin). Ikkalasi bo'lsagina yoqiladi.
# dash.cloudflare.com → AI → Workers AI → "Use REST API":
#   "Get Account ID" → CLOUDFLARE_ACCOUNT_ID;  "Create a Workers AI API Token" → Create → Copy → CLOUDFLARE_AI_TOKEN
#   (qo'lda yaratilsa ruxsatlar: Workers AI - Read va Workers AI - Edit). Token hech qachon commit qilinmaydi.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
GOOGLE_AI_API_KEY=
# NVIDIA NIM — tekin, karta kerak emas: https://build.nvidia.com (40 so'rov/daqiqa, 10 000/kun)
NVIDIA_API_KEY=
# LLM7 — kalitsiz ham ishlaydi (oxirgi zaxira). Token limitni oshiradi: https://token.llm7.io
LLM7_API_KEY=
# LLM7 ni butunlay o'chirish (1/true) — standartda anonim oxirgi zaxira sifatida yoqiq
LLM7_DISABLED=
# OpenRouter tekin (:free) kunlik so'rov limiti: 50 (standart); $10+ kredit olingan hisobda 1000
OPENROUTER_FREE_RPD=
# Provider Mesh (docs/MESH.md) — barcha provayderlar bitta algoritm bilan: on (standart) | shadow | off (eski zanjir)
SOVEREIGN_MESH=

# --- Zaxira shlyuzlar (OpenAI-mos). Kalit qo'yilsa ishlaydi, aks holda o'tkazib yuboriladi ---
# Experiential Labs: https://platform.experientiallabs.ai/settings/api-keys
EXPERIENTIAL_API_KEY=
EXPERIENTIAL_MODEL=claude-3-haiku
# O'zingiz ko'targan OmniRoute (npm i -g omniroute) manzili, masalan http://localhost:4000/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
# Boshqa har qanday OpenAI-mos shlyuz (masalan https://api.17.wtf/v1)
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=

# --- Tella 2 — o'z modelimiz (D:\My_apps\tella2, Qwen2.5 + Ollama) ---
# Lokal: http://localhost:11434/v1  |  Serverda: https://tella.domeningiz.uz/v1
TELLA_BASE_URL=
TELLA_MODEL=tella2
TELLA_API_KEY=
# Model ro'yxatida ko'rinishi uchun (server ko'tarilgan bo'lsa) "1" qo'ying.
NEXT_PUBLIC_TELLA_ENABLED=

# --- Tella 2 ni o'rgatish (distillation) ---
# "on" bo'lsa, kuchli modellar javoblari trening bazasiga yoziladi.
# Fayl/bilim bazasi/Cowork/maxfiy rejim ishlatilgan suhbatlar hech qachon olinmaydi.
TRAINING_CAPTURE=off

# --- To'lov: Dodo Payments (karta obunasi) ---
DODO_PAYMENTS_ENV=live
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=

# --- Plans (to'lov ulanguncha) ---
# Tarifni Narxlar oynasidan to'g'ridan-to'g'ri almashtirishga ruxsat (faqat test uchun).
ALLOW_PLAN_SWITCH=false
# Project Settings → API Keys → service_role (serverda tarif yozish uchun). Hech qachon client'ga bermang.
SUPABASE_SERVICE_ROLE_KEY=

# --- To'lov: ZenoBank (kripto checkout) ---
# Dashboard → Developer: https://dashboard.zenobank.io/developer
ZENOBANK_API_KEY=
ZENOBANK_WEBHOOK_SECRET=

# --- API byudjeti: "sarf daromadning 50% idan oshmasin" (src/lib/econ/budget.ts) ---
# Joriy oy API sarfi (unit-economics taxmini) / daromad (to'langan buyurtmalar) nisbati.
# Sarf ruxsatga (max(BUDGET_MIN_MONTHLY_USD, daromad × BUDGET_CAP_RATIO)) yetsa mesh faqat tekin
# takliflarni tanlaydi. Bo'sh qoldirilsa standart: WARN 0.4, CAP 0.5, MIN 5 (USD).
BUDGET_WARN_RATIO=
BUDGET_CAP_RATIO=
BUDGET_MIN_MONTHLY_USD=
# RollyPay /rate (USDT/RUB) ishlamasa RUB buyurtmalarni USD'ga o'girish kursi (masalan 92). Bo'sh — RUB hisoblanmaydi.
BUDGET_RUB_PER_USD=
# OpenRouter balansi shundan kam bo'lsa alert (USD, standart 3)
OPENROUTER_ALERT_USD=
# GET /api/v1/credits uchun OpenRouter "management key" (ixtiyoriy; bo'lmasa OPENROUTER_API_KEY sinaladi)
OPENROUTER_MANAGEMENT_KEY=
# Cron himoyasi (GitHub Actions: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Upstash Redis (guard keshi, alert dedupe; bo'lmasa instansiya xotirasi)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alertlar — Telegram: @BotFather'dan bot tokeni; chat id: botga /start yozing, keyin
# https://api.telegram.org/bot<TOKEN>/getUpdates javobidagi "chat":{"id":...} qiymati
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Alertlar — email (Resend orqali, RESEND_API_KEY kerak) va alert tili: uz | uz-cyrl | ru | en (standart uz)
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_LANG=
# Unsubscribe havolalarini imzolash — CRON_SECRET'dan ALOHIDA, 32+ tasodifiy bayt (bo'lmasa CRON_SECRET ishlatiladi)
EMAIL_TOKEN_SECRET=
# Almashtirish (rotation) vaqtida oldingi kalit — mas. CRON_SECRET fallback'dan ko'chishda uning joriy qiymati
EMAIL_TOKEN_SECRET_PREV=
# Connector OAuth tokenlarini DB'da shifrlash (AES-256-GCM): 32 bayt, base64 yoki hex. Bo'sh — shifrlanmaydi
CONNECTOR_TOKEN_KEY=
# Kalit almashtirishda oldingi kalit (ixtiyoriy, eski yozuvlarni ochish uchun)
CONNECTOR_TOKEN_KEY_PREV=
# Cloudflare Turnstile sayt kaliti (Supabase Auth CAPTCHA; maxfiy kalit Supabase Dashboard'ga qo'yiladi)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 1 — Supabase sessiya cookie'si httpOnly (faqat Google kirish server action'ga o'tgach yoqing)
SESSION_COOKIE_HTTPONLY=
